# Shared environment for pi, loaded by extensions/00-env.ts before any other
# extension. Tracked in the dotfiles repo: non-secret switches only. Per-machine
# values and secrets go in ~/.pi/agent/.env, which is never synced. A variable
# already exported in your shell wins over both files.

# pi-background-tasks: background shell jobs only (bg_run, bg_logs, bg_status,
# bg_kill). Drops the Fusion, delegate and attested tools — ~3.9k tokens of tool
# definitions per session. `process` is the one mandatory feature.
PI_BG_FEATURES=process
