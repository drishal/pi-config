{
  "theme": "gruvbox-material",
  "packages": [
    "npm:@capdiem/pi-ask-user",
    "npm:@gamaraan/todos-tool",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-background-tasks",
    "npm:pi-context-view",
    "npm:pi-hashline-edit-pro",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-mono-review",
    "npm:pi-simplify",
    "npm:pi-web-access",
    "npm:pi-x-search"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "find"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 45000,
    "keepRecentTokens": 30000
  },
  "markdown": {
    "mermaid": "final"
  },
  "statusline": {
    "hide": []
  }
}
